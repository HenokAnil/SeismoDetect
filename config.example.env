# SeismoDetect — environment configuration template
# Copy to .env and set real values before running.

# --- Core services ---
DATABASE_URL=postgresql://seismo_user:seismo_password@localhost:5432/seismodetect
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=seismic-waveforms
REDIS_URL=redis://localhost:6379/0
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- RAG report generation ---
# Set USE_LLM_EXPLAIN=true to enable T5 generation (requires transformers installed).
# Leave false to use the deterministic template (no GPU / download needed).
USE_LLM_EXPLAIN=false

# HuggingFace model ID for the narrative generator.
# Options: t5-small (fast, lower quality) | t5-base | google/flan-t5-base (best)
REPORT_MODEL=t5-small

# Set REPORT_PDF=true to generate PDF artefacts via WeasyPrint.
REPORT_PDF=false

# --- USGS enrichment ---
# Set USGS_CACHE_DB=true to cache USGS GeoJSON responses in Postgres (default behaviour).
USGS_CACHE_DB=true

# --- Optional external LLM ---
# Set LLM_API_KEY if you want to route generation to an external API instead of local T5.
# LLM_API_KEY=sk-...
